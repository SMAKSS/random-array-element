{
  "author": "SMAKSS",
  "bugs": {
    "url": "https://github.com/SMAKSS/random-array-element/issues"
  },
  "description": "Efficiently select unique, non-repeating random elements from arrays with @smakss/random-array-element. Ideal for varied applications needing random but exhaustive array item selection.",
  "devDependencies": {
    "@commitlint/cli": "^18.4.3",
    "@commitlint/config-conventional": "^18.4.3",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^8.57.1",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0",
    "prettier": "^3.1.1",
    "tslib": "^2.6.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "homepage": "https://github.com/SMAKSS/random-array-element#readme",
  "keywords": [
    "random-element-selection",
    "unique-array-elements",
    "non-repeating-random",
    "array-element-picker",
    "random-array-element",
    "random-index",
    "random-array-element-without-repetition",
    "random-element-without-repeat",
    "npm",
    "yarn",
    "array",
    "SMAKSS",
    "random",
    "CommonJS",
    "EcmaScript",
    "Typescript"
  ],
  "license": "MIT",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "name": "@smakss/random-array-element",
  "packageManager": "pnpm@12.17.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SMAKSS/random-array-element.git"
  },
  "scripts": {
    "build:playground": "pnpm run generate && pnpm --filter random-array-element-playground build",
    "dev:playground": "pnpm run generate && pnpm --filter random-array-element-playground dev",
    "format": "prettier --write \"**/*.+(js|mjs|json|yml|yaml|ts|mts|cts|md|css|html)\"",
    "format:check": "prettier -l \"**/*.+(js|mjs|json|yml|yaml|ts|mts|cts|md|css|html)\"",
    "generate": "vite build && pnpm run generate:types",
    "generate:types": "tsc -p tsconfig.build.json && node create-declaration-entrypoints.js",
    "generate:check": "pnpm run format && pnpm run lint && pnpm run typecheck",
    "lint": "pnpm run lint:main && pnpm run lint:playground",
    "lint:main": "eslint --cache --cache-location ./node_modules/.cache/.eslintcache --ext js,ts --max-warnings=0 .",
    "lint:playground": "pnpm --filter random-array-element-playground lint",
    "lint:fix": "eslint src/**/*.ts --fix",
    "setup": "pnpm install && pnpm exec husky install",
    "test": "pnpm run generate && node --test",
    "typecheck": "tsc -b . && pnpm run generate:types && tsc -p tsconfig.package-types.json && pnpm --filter random-array-element-playground typecheck",
    "typecheck:playground": "pnpm run generate:types && pnpm --filter random-array-element-playground typecheck"
  },
  "type": "module",
  "types": "./dist/index.d.cts",
  "version": "2.0.3"
}
